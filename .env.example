# Active environment: qa | staging | prod
TEST_ENV=qa

# Browser settings
HEADLESS=true
SLOW_MO=0
BROWSER=chromium

# Parallel workers (0 = auto)
WORKERS=2

# Timeouts (ms)
DEFAULT_TIMEOUT=30000
NAVIGATION_TIMEOUT=45000

# Reporting
SCREENSHOT_ON_FAILURE=true
VIDEO_ON_FAILURE=true
TRACE_ON_RETRY=true
